{
  "name": "tlg",
  "version": "0.1.0",
  "private": true,
  "description": "The LAN Game — Kerker: asymmetrisches 1-gegen-viele im Browser, Login über Craftworks",
  "type": "module",
  "workspaces": ["packages/shared", "server", "client"],
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "test": "node --test \"packages/shared/test/**/*.test.js\" \"server/test/**/*.test.js\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "start": "node server/src/index.js"
  }
}
